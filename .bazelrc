# .bazelrc — cargo-runner Bazel configuration

# ── Disk cache (reused across workspaces on the same machine) ─────────────────
build --disk_cache=~/.cache/bazel-disk
fetch --disk_cache=~/.cache/bazel-disk

# ── Repository cache (share downloaded archives across Bazel workspaces) ──────
common --repository_cache=~/.cache/bazel-repo

# ── Build defaults ────────────────────────────────────────────────────────────
build --jobs=auto
build --keep_going

# ── Test defaults ─────────────────────────────────────────────────────────────
test --test_output=errors
test --keep_going

# ── Rust / rules_rust ─────────────────────────────────────────────────────────
build --@rules_rust//:extra_rustc_flags=-Dwarnings

# ── macOS / Apple Silicon ─────────────────────────────────────────────────────
# Uncomment if building on Apple Silicon and Bazel picks the wrong CPU:
# build --cpu=darwin_arm64

# ── Buildbuddy Remote Cache + BES (CI) ────────────────────────────────────────
build:remote --remote_upload_local_results=true
# Enable remote config in CI (set by ci.yml)
build:ci --config=remote

# BES upload is CI-only: scoped to :ci so local builds don't report to a third
# party by default. CI supplies the credential out-of-band via
#   --remote_header=x-buildbuddy-api-key=${BUILDBUDDY_API_KEY}
# from secrets (see .github/workflows/ci.yml).
build:ci --bes_results_url=https://codeitlikemiley.buildbuddy.io/invocation/
build:ci --bes_backend=grpcs://codeitlikemiley.buildbuddy.io

# NEVER put an API key in this file — it is committed and public.
# For local BES uploads, put the header in user.bazelrc (git-ignored):
#   common --remote_header=x-buildbuddy-api-key=YOUR_KEY
try-import %workspace%/user.bazelrc
